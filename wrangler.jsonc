{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kamilkolodziejczyk-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "kamilkolodziejczyk.dev", "custom_domain": true },
    { "pattern": "www.kamilkolodziejczyk.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "kv_namespaces": [{ "binding": "CONTACT_LIMITS", "id": "a8c1bbe1a0164578874b6d67dda6b0d4" }],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    "CONTACT_FROM": "formularz@kamilkolodziejczyk.dev",
    "CONTACT_DAILY_LIMIT": "20"
  },
  "observability": {
    "enabled": true
  }
}
