{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kamilkolodziejczyk-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "vars": {
    "CONTACT_FROM": "formularz@kamilkolodziejczyk.dev"
  },
  "observability": {
    "enabled": true
  }
}
