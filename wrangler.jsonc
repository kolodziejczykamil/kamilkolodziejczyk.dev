{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kamilkolodziejczyk-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "kamilkolodziejczyk.dev", "custom_domain": true },
    { "pattern": "www.kamilkolodziejczyk.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "vars": {
    "CONTACT_FROM": "formularz@kamilkolodziejczyk.dev"
  },
  "observability": {
    "enabled": true
  }
}
